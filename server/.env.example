# ---- HTTP ----
PORT=4000
# Public base URL of this API (used to build signed media / local upload URLs)
PUBLIC_API_URL=http://localhost:4000
# Web client origin (share links point here)
CLIENT_URL=http://localhost:5173
# Extra comma-separated CORS origins. chrome-extension:// and Tauri origins are always allowed.
CORS_ORIGINS=

# ---- Security ----
# REQUIRED in production. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# ---- Persistence ----
DATA_DIR=./data
# DATABASE_PATH=./data/spool.db

# ---- Storage ----
# "local" stores media on disk (multipart emulated by the API); "s3" uses AWS S3 / R2 / MinIO.
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=us-east-1
# Optional custom endpoint (Cloudflare R2, MinIO, ...)
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
UPLOAD_PART_SIZE_MB=8

# ---- Media pipeline ----
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
PIPELINE_CONCURRENCY=2
MAX_RECORDING_SECONDS=420

# ---- AI ----
# Transcription: "openai" (Whisper) or "deepgram". Leave empty to auto-detect from keys.
TRANSCRIPTION_PROVIDER=
# LLM + embeddings: "openai" or "gemini". Leave empty to auto-detect from keys.
LLM_PROVIDER=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
GEMINI_API_KEY=
# Optional overrides
LLM_MODEL=
EMBEDDING_MODEL=
