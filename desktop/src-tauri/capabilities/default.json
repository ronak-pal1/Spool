{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Spool main window and recording overlays",
  "windows": ["main", "bar", "camera", "area", "draw"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "core:window:allow-scale-factor",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-set-focus",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-ignore-cursor-events",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-cursor-position",
    "opener:default",
    "allow-list-sources",
    "allow-list-audio-devices",
    "allow-start-recording",
    "allow-pause-recording",
    "allow-resume-recording",
    "allow-set-mic-muted",
    "allow-set-system-muted",
    "allow-stop-recording",
    "allow-discard-recording",
    "allow-restart-recording",
    "allow-retry-upload",
    "allow-recording-snapshot",
    "allow-prepare-area-select",
    "allow-cancel-area-select",
    "allow-complete-area-select",
    "allow-camera-config",
    "allow-set-camera-size",
    "allow-set-camera-click-through",
    "allow-set-draw-enabled"
  ]
}
